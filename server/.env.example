# Server
PORT=5000
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=12h
JWT_ISSUER=cra8-cms
JWT_AUDIENCE=cra8-admin

# CORS (comma-separated frontend origins)
CORS_ORIGIN=http://localhost:8080

# Admin seed defaults
ADMIN_USERNAME=cra8
ADMIN_PASSWORD=change-this-to-a-strong-password
# Safety: keep false in production. Temporarily set true only when intentionally running seed.
ALLOW_PROD_SEED=false

# Upload limits
MAX_UPLOAD_MB=25

# Storage driver: local | s3 | cloudinary
# Use local for development only. In production use cloudinary or s3.
STORAGE_DRIVER=local

# SQLite DB path. In production, point this to a mounted persistent volume.
# Example: /var/data/cms.db
CMS_DB_PATH=

# S3 / S3-compatible object storage (required if STORAGE_DRIVER=s3)
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Public base URL for uploaded objects (recommended)
# Example: https://cdn.yourdomain.com OR https://<account>.r2.cloudflarestorage.com/<bucket>
S3_PUBLIC_BASE_URL=

# Cloudinary (required if STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cra8
