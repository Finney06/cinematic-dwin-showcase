# Server
PORT=5000
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=12h
JWT_ISSUER=cra8-cms
JWT_AUDIENCE=cra8-admin

# CORS (comma-separated frontend origins)
CORS_ORIGIN=http://localhost:8080

# Initial admin account: created only when no admin exists. Never overwrites a changed password.
ADMIN_USERNAME=cra8
# Use 12+ characters, uppercase, lowercase, number and symbol; maximum 72 UTF-8 bytes.
ADMIN_PASSWORD=
# Recovery mailbox for ADMIN_USERNAME. Use an inbox you own and have verified.
# Requires SMTP settings below and SITE_URL pointing to the frontend (HTTPS in production).
ADMIN_RECOVERY_EMAIL=
# Safety: keep false in production. Temporarily set true only when intentionally running seed.
ALLOW_PROD_SEED=false

# Upload limits
MAX_UPLOAD_MB=25

# Storage driver: local | s3 | cloudinary
# Use local for development only. In production use cloudinary or s3.
STORAGE_DRIVER=local

# Persistent PostgreSQL database (required)
DATABASE_URL=

# S3 / S3-compatible object storage (required if STORAGE_DRIVER=s3)
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Public base URL for uploaded objects (recommended)
# Example: https://cdn.yourdomain.com OR https://<account>.r2.cloudflarestorage.com/<bucket>
S3_PUBLIC_BASE_URL=

# Cloudinary (required if STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cra8

# Contact form email: each enquiry is also emailed here (it is always saved in Admin → Messages).
# With Gmail: turn on 2-Step Verification, create an App Password, and use it as SMTP_PASS.
CONTACT_NOTIFY_EMAIL=cra8.academy@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to "CRA8 Website <SMTP_USER>". Required when SMTP_USER is not an email
# address (e.g. Resend: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=re_...).
MAIL_FROM=CRA8 Website <noreply@cra8limited.com>

# Public site address (used by the sitemap and contact emails)
SITE_URL=https://cra8limited.com
